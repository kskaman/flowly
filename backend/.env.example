PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Hostnames "db" and "cache" resolve inside docker compose; use localhost when running the API on the host.
DATABASE_URL=postgresql://flowly_user:change_me@db:5432/flowly_db?schema=public
POSTGRES_USER=flowly_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=flowly_db

REDIS_URL=redis://cache:6379

# Local email goes to Mailpit (inbox UI at http://localhost:8025).
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_REQUIRE_TLS=false
EMAIL_FROM=no-reply@flowly.local
EMAIL_USER=
EMAIL_PASS=
